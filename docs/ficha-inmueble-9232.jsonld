d":"7.492.494.497.509.516.970.14459"}]},"proteccion_s":"SI","provincia":{"schema:name":"Granada","foaf:name":"Granada","@id":"http://es.dbpedia.org/resource/Granada","@type":"schema:State"},"proteccionList":{"proteccion":{"pagina":null,"fecha":"07/12/1981","estado":"Inscrito","numero":null,"figura":"BIC","den_publica":"BOE","tipologia":"Monumento"}},"identifica":{"descripcion":{"@text":"La iglesia de planta rectangular, consta de tres naves con crucero separadas por pilares cruciformes que sostienen arcos de medio punto. Se cubre la nave central con artesonado de tirantes y racimos dorados. El techo de la capilla mayor es un artesonado mudéjar con rica lacería. Las naves o capillas laterales tienen bóveda de crucería.\nLa torre situada a los pies de la iglesia es de dos cuerpos y campanario separados por pequeñas cornisas. Sufrió grandes desperfectos en el terremoto del 56. Los muros de la iglesia son de fábrica de ladrillo con cajones de mampostería y tapial.","Resources":[]},"tipo":"i","codigo":"01180030001","estado":"Aceptada","raac":null,"municipio":{"schema:name":"Albolote","foaf:name":"Albolote","@id":"http://es.dbpedia.org/resource/Albolote","@type":"schema:City"},"caracterizacion":"Arquitectónica","codigosipha":180030001,"provincia":{"schema:name":"Granada","foaf:name":"Granada","@id":"http://es.dbpedia.org/resource/Granada","@type":"schema:State"},"dat_historico":"Para su construcción se demolió la antigua iglesia existente en el año 1580. Ambrosio de Vico intervino en 1587 en la ejecución de las trazas de la iglesia que habría de ser de cantería de piedra del Cuibillas.","pi_pi_id":null,"denominacion":"Iglesia de la Encarnación","dir_postal":null,"id":9232,"otr_denom":"Otra"},"clob":{"descripcion":{"@text":"La iglesia de planta rectangular, consta de tres naves con crucero separadas por pilares cruciformes que sostienen arcos de medio punto. Se cubre la nave central con artesonado de tirantes y racimos dorados. El techo de la capilla mayor es un artesonado mudéjar con rica lacería. Las naves o capillas laterales tienen bóveda de crucería.\nLa torre situada a los pies de la iglesia es de dos cuerpos y campanario separados por pequeñas cornisas. Sufrió grandes desperfectos en el terremoto del 56. Los muros de la iglesia son de fábrica de ladrillo con cajones de mampostería y tapial.","Resources":[]}},"pHistorico_smvList":{"pHistorico_smv":["Edad Moderna","Edad Moderna"]},"bibliografiaList":{"bibliografia":{"editorial":null,"a_o":null,"isbn_issn":null,"tipo":14,"volumen":null,"lugar":null,"fec_pub":1975,"titulo":"El yacimiento de la Edad del Bronce de Cuesta del Negro: Purullena, Granada","titulo_bib":null,"pag_pub":"-","tit":12048,"autor":"PAREJA LÓPEZ, Enrique; MOLINA GONZÁLEZ, Fernando Ricardo"}},"id":9232,"provincia_smvList":{"provincia_smv":"Granada"},"denominacionList":{"denominacion":[{"denominacion":"Iglesia Parroquial de la Encarnación"},{"denominacion":"Iglesia de la Encarnación del Hijo de Dios y Anunciación de Nuestra Señora"}]},"provincia_s":"Granada","busqueda_denominacionList":{"busqueda_denominacion":["Iglesia de la Encarnación","Iglesia Parroquial de la Encarnación","Iglesia de la Encarnación del Hijo de Dios y Anunciación de Nuestra Señora"]},"codigo":"01180030001","municipio_s":"Albolote","municipio":{"schema:name":"Albolote","foaf:name":"Albolote","@id":"http://es.dbpedia.org/resource/Albolote","@type":"schema:City"},"caracterizacion":"Arquitectónica","busqueda_genericaList":{"busqueda_generica":["Vico , Ambrosio de","01180030001","Iglesia de la Encarnación","Iglesia Parroquial de la Encarnación","Iglesia de la Encarnación del Hijo de Dios y Anunciación de Nuestra Señora","Albolote","Albolote","Monumento","Granada","Granada","Renacimiento (Estilo)","Mudéjar",null,null,"Iglesias parroquiales","Iglesias parroquiales","Ceremonia cristiana","Ceremonia cristiana","Edad Moderna","Edad Moderna"]},"tipologia_smvList":{"tipologia_smv":["Iglesias parroquiales","Iglesias parroquiales"]},"imagenList":{"imagen":{